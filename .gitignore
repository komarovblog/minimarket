# Local secrets, Joomla-generated configuration
.env
.env.*
!.env.example
configuration.php

# Version the OSP project profile, but never its runtime files.
/.osp/*
!/.osp/project.ini

# Joomla 6 is installed only locally. Keep the directory in Git, not CMS files.
/public_html/*
!/public_html/.gitkeep

# Old local webroot (before renaming). Never accidentally track Joomla files there.
/public/

# Local build outputs / runtime / backups
/vendor/
/node_modules/
/.cache/
/runtime/
/tmp/
/dist/
/backups/
*.zip
*.dump.sql
*.sql.gz
*.bak
*.log
