# Секреты и локальные настройки
.env
.env.*
!.env.example
configuration.php

# Окружение Open Server Panel 6 и установленное ядро Joomla 6.
# Код наших расширений разрабатываем и храним вне /public в исходниках репозитория.
/.osp/
/public/

# Зависимости и локальные артефакты
/vendor/
/node_modules/
/.cache/
/runtime/
/tmp/
/dist/
/backups/
*.zip
*.dump.sql
*.sql.gz
*.bak
*.log
# Единственный Git-лог проверок: предыдущие версии доступны в истории коммитов.
!/logs/LAST_RUN.log
