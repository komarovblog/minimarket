# Пример локальных параметров minimarket. Реальные значения и секреты — только в .env.
# Ключи .env и .env.example обязаны совпадать.
APP_ENV=local
APP_DEBUG=0
SHOP_BASE_URL=http://minimarket.local
# Пока используется только как будущий параметр подключения собственного кода.
# Joomla также имеет собственный configuration.php, который в Git не сохраняем.
SHOP_DB_HOST=127.0.0.1
SHOP_DB_PORT=3306
SHOP_DB_NAME=minimarket
SHOP_DB_USER=minimarket
SHOP_DB_PASSWORD=
