<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>COM_MINIMARKET</name>
    <element>com_minimarket</element>
    <creationDate>2026-10-30</creationDate>
    <author>MiniMarket</author>
    <copyright>Copyright (C) MiniMarket contributors</copyright>
    <license>GNU General Public License version 3 or later</license>
    <version>0.5.82</version>
    <description>COM_MINIMARKET_XML_DESCRIPTION</description>
    <namespace path="src">MiniMarket\Component\Minimarket</namespace>

    <files folder="site">
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <media destination="com_minimarket" folder="media">
        <folder>js</folder>
        <folder>css</folder>
    </media>

    <administration>
        <files folder="admin">
            <filename>config.xml</filename>
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>language</folder>
            <folder>forms</folder>
            <folder>presets</folder>
            <folder>examples</folder>
            <folder>sql</folder>
        </files>
        <menu img="class:cart">COM_MINIMARKET
            <params><dashboard>minimarket</dashboard></params>
        </menu>
        <submenu>
            <menu link="option=com_minimarket&amp;view=orders">COM_MINIMARKET_ORDERS_TITLE
                <params><menu-quicktask-title>JNEW</menu-quicktask-title><menu-quicktask>index.php?option=com_minimarket&amp;view=order&amp;layout=create</menu-quicktask><menu-quicktask-icon>plus</menu-quicktask-icon></params>
            </menu>
            <menu link="option=com_minimarket&amp;view=deliveries">COM_MINIMARKET_DASHBOARD_DELIVERIES</menu>
            <menu type="separator" alias="mm-separator-orders">-</menu>
            <menu link="option=com_minimarket&amp;view=categories">COM_MINIMARKET_CATEGORIES
                <params><menu-quicktask-title>JNEW</menu-quicktask-title><menu-quicktask>index.php?option=com_minimarket&amp;task=category.add</menu-quicktask><menu-quicktask-icon>plus</menu-quicktask-icon></params>
            </menu>
            <menu type="separator" alias="mm-separator-1">-</menu>
            <menu link="option=com_minimarket&amp;view=products">COM_MINIMARKET_PRODUCTS
                <params><menu-quicktask-title>JNEW</menu-quicktask-title><menu-quicktask>index.php?option=com_minimarket&amp;view=product&amp;layout=edit&amp;product_type=simple</menu-quicktask><menu-quicktask-icon>plus</menu-quicktask-icon></params>
            </menu>
            <menu link="option=com_minimarket&amp;view=bundles">COM_MINIMARKET_BUNDLES
                <params><menu-quicktask-title>JNEW</menu-quicktask-title><menu-quicktask>index.php?option=com_minimarket&amp;view=product&amp;layout=edit&amp;product_type=bundle</menu-quicktask><menu-quicktask-icon>plus</menu-quicktask-icon></params>
            </menu>
            <menu type="separator" alias="mm-separator-2">-</menu>
            <menu link="option=com_minimarket&amp;view=groups">COM_MINIMARKET_GROUPS</menu>
            <menu link="option=com_minimarket&amp;view=bundlegroups">COM_MINIMARKET_BUNDLE_GROUPS</menu>
            <menu type="separator" alias="mm-separator-3">-</menu>
            <menu link="option=com_minimarket&amp;view=attributes">COM_MINIMARKET_ATTRIBUTES</menu>
            <menu link="option=com_minimarket&amp;view=orderoptions">COM_MINIMARKET_ORDER_OPTIONS</menu>
            <menu type="separator" alias="mm-separator-4">-</menu>
            <menu link="option=com_minimarket&amp;view=brands">COM_MINIMARKET_BRANDS</menu>
            <menu type="separator" alias="mm-separator-5">-</menu>
            <menu link="option=com_minimarket&amp;view=collections">COM_MINIMARKET_COLLECTIONS</menu>
            <menu type="separator" alias="mm-separator-6">-</menu>
            <menu link="option=com_minimarket&amp;view=import">COM_MINIMARKET_IMPORT_TITLE</menu>
            <menu link="option=com_minimarket&amp;view=feeds">COM_MINIMARKET_FEEDS_TITLE</menu>
            <menu type="separator" alias="mm-separator-settings">-</menu>
            <menu link="option=com_config&amp;view=component&amp;component=com_minimarket">COM_MINIMARKET_CONFIG_SETTINGS_MENU</menu>
        </submenu>
    </administration>
    <dashboards>
        <dashboard title="COM_MINIMARKET_DASHBOARD_TITLE" icon="icon-cart">minimarket</dashboard>
    </dashboards>
    <scriptfile>script.php</scriptfile>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.sql</file>
        </sql>
    </install>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>
</extension>
