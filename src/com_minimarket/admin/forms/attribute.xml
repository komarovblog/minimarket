<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="MiniMarket\Component\Minimarket\Administrator\Field">
    <fieldset name="details" label="COM_MINIMARKET_ATTRIBUTE_DETAILS">
        <field name="id" type="hidden" default="0" filter="int"/>
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" filter="string" size="60"/>
        <field name="code" type="text" label="COM_MINIMARKET_ATTRIBUTE_CODE" description="COM_MINIMARKET_ATTRIBUTE_CODE_DESC" required="true" filter="string" size="40"/>
        <field name="input_type" type="list" label="COM_MINIMARKET_ATTRIBUTE_TYPE" description="COM_MINIMARKET_ATTRIBUTE_TYPE_DESC" default="text" filter="cmd">
            <!-- Existing ID-based List attributes remain editable for legacy catalog data.
                 The editor hides this option when creating a new attribute. -->
            <option value="list">COM_MINIMARKET_ATTRIBUTE_LEGACY_LIST</option>
            <option value="text">COM_MINIMARKET_ATTRIBUTE_TEXT</option>
            <option value="number">COM_MINIMARKET_ATTRIBUTE_NUMBER</option>
            <option value="boolean">COM_MINIMARKET_ATTRIBUTE_BOOLEAN</option>
            <option value="editor">COM_MINIMARKET_ATTRIBUTE_EDITOR</option>
            <!-- Document and Color are new first-class types. -->
            <option value="document">COM_MINIMARKET_ATTRIBUTE_DOCUMENT</option>
            <!-- Color HEX swatches can be selected in products. -->
            <option value="color">COM_MINIMARKET_ATTRIBUTE_COLOR</option>
            <!-- Older records still use these types. No new records may select them. -->
            <option value="textarea">COM_MINIMARKET_ATTRIBUTE_TEXTAREA</option>
            <option value="date">COM_MINIMARKET_ATTRIBUTE_DATE</option>
            <option value="url">COM_MINIMARKET_ATTRIBUTE_URL</option>
        </field>
        <!-- Storage representation stays internal so existing catalog data survives. -->
        <field name="value_source" type="hidden" default="manual" filter="cmd"/>
        <field name="value_source_ui" type="list" label="COM_MINIMARKET_VALUE_SOURCE"
               description="COM_MINIMARKET_VALUE_SOURCE_DESC" default="manual" filter="cmd"
               showon="input_type!:boolean">
            <option value="manual">COM_MINIMARKET_VALUE_SOURCE_MANUAL</option>
            <option value="preset">COM_MINIMARKET_VALUE_SOURCE_PRESET</option>
        </field>
        <field name="is_multiple" type="list" label="COM_MINIMARKET_ATTRIBUTE_MULTIPLE"
               description="COM_MINIMARKET_UNIFIED_MULTIPLE_DESC"
               default="0" filter="int" showon="input_type!:boolean">
            <option value="0">COM_MINIMARKET_ATTRIBUTE_SINGLE</option>
            <option value="1">COM_MINIMARKET_ATTRIBUTE_MULTI</option>
        </field>
        <field name="unified_values" type="subform" label="COM_MINIMARKET_UNIFIED_VALUES"
               description="COM_MINIMARKET_UNIFIED_VALUES_DESC"
               formsource="administrator/components/com_minimarket/forms/attribute_unified_value_row.xml"
               multiple="true" min="0" max="1000" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"
               showon="value_source:preset"/>
        <field name="color_display" type="list" label="COM_MINIMARKET_COLOR_DISPLAY"
               default="both" filter="cmd" showon="input_type:color">
            <option value="both">COM_MINIMARKET_COLOR_DISPLAY_BOTH</option>
            <option value="swatch">COM_MINIMARKET_COLOR_DISPLAY_SWATCH</option>
        </field>
        <!-- Old input mode stays in a hidden persisted field; no second
             "Product input" dropdown or compatibility controls. -->
        <field name="input_mode" type="hidden" default="auto" filter="cmd"/>
        <field name="text_options" type="hidden" filter="raw"/>
        <field name="text_preset_rows" type="subform"
               label="COM_MINIMARKET_TEXT_OPTIONS"
               description="COM_MINIMARKET_TEXT_OPTIONS_DESC"
               formsource="administrator/components/com_minimarket/forms/attribute_text_preset_row.xml"
               multiple="true" min="0" max="200" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"
               showon="value_source:legacy[AND]input_type:text[AND]input_mode:presets"/>
        <!-- Persist numeric values as a typed CSV for compatibility with 0.5.12.
             The editor below is the ONLY visible control. -->
        <field name="number_options" type="hidden" filter="raw"/>
        <field name="number_preset_rows" type="subform"
               label="COM_MINIMARKET_NUMBER_OPTIONS"
               description="COM_MINIMARKET_NUMBER_OPTIONS_ROWS_DESC"
               formsource="administrator/components/com_minimarket/forms/attribute_number_preset_row.xml"
               multiple="true" min="0" max="500" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"
               showon="value_source:legacy[AND]input_type:number[AND]input_mode:presets"/>
        <field name="number_unit" type="text" label="COM_MINIMARKET_NUMBER_UNIT"
               maxlength="32" filter="string" showon="input_type:number"/>
        <field name="number_min" type="number" label="COM_MINIMARKET_NUMBER_MIN"
               step="0.0001" filter="raw" showon="input_type:number"/>
        <field name="number_max" type="number" label="COM_MINIMARKET_NUMBER_MAX"
               step="0.0001" filter="raw" showon="input_type:number"/>
        <field name="number_step" type="number" label="COM_MINIMARKET_NUMBER_STEP"
               min="0.0001" step="0.0001" filter="raw" showon="input_type:number"/>
        <field name="color_values" type="subform"
               label="COM_MINIMARKET_COLOR_OPTIONS"
               description="COM_MINIMARKET_COLOR_OPTIONS_DESC"
               formsource="administrator/components/com_minimarket/forms/attribute_color_row.xml"
               multiple="true" min="0" max="1000" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"
               showon="value_source:legacy[AND]input_type:color"/>
        <field name="values" type="subform"
               label="COM_MINIMARKET_ATTR_VALUES_TAB"
               description="COM_MINIMARKET_VALUE_INLINE_HELP"
               formsource="administrator/components/com_minimarket/forms/attribute_value_row.xml"
               multiple="true" min="0" max="1000" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"
               showon="value_source:legacy[AND]input_type:list"/>

    </fieldset>
    <!-- The repeatable value rows use exactly the same Joomla Subform UI
         as the product gallery. Omitted rows mean deletion of relations. -->
    <field name="values_present" type="hidden" filter="int" default="1"/>
    <fieldset name="categories" label="COM_MINIMARKET_ATTRCAT_TAB">
        <field name="category_rules" type="Attributecategories"
            label="COM_MINIMARKET_ATTRCAT_LABEL" filter="raw"/>
        <field name="categories_present" type="hidden" default="1" filter="int"/>
    </fieldset>
    <fieldset name="filter" label="COM_MINIMARKET_ATTRIBUTE_FILTER_TAB">
        <field name="is_filterable" type="radio" label="COM_MINIMARKET_ATTRIBUTE_FILTERABLE" description="COM_MINIMARKET_ATTRIBUTE_FILTERABLE_DESC" default="0" filter="integer">
            <option value="1">JYES</option><option value="0">JNO</option>
        </field>
        <field name="filter_mode" type="list" label="COM_MINIMARKET_FILTER_MODE"
               description="COM_MINIMARKET_FILTER_MODE_DESC" default="none" filter="cmd" showon="is_filterable:1">
            <option value="none">COM_MINIMARKET_MODE_NONE</option>
            <option value="text">COM_MINIMARKET_FILTER_TEXT</option>
            <option value="values">COM_MINIMARKET_FILTER_VALUES</option>
            <option value="range">COM_MINIMARKET_FILTER_RANGE</option>
            <option value="slider">COM_MINIMARKET_FILTER_SLIDER</option>
            <option value="checkboxes">COM_MINIMARKET_MODE_CHECKBOXES</option>
            <option value="radio">COM_MINIMARKET_MODE_RADIO</option>
            <option value="dropdown">COM_MINIMARKET_MODE_DROPDOWN</option>
            <option value="boolean">COM_MINIMARKET_ATTRIBUTE_BOOLEAN</option>
            <option value="date_range">COM_MINIMARKET_FILTER_DATE_RANGE</option>
            <option value="swatches">COM_MINIMARKET_FILTER_SWATCHES</option>
        </field>
        <field name="filter_multiple" type="radio" label="COM_MINIMARKET_FILTER_MULTIPLE"
               description="COM_MINIMARKET_FILTER_MULTIPLE_DESC" default="0" filter="int"
               showon="is_filterable:1[AND]filter_mode:dropdown,values">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="filter_planned_notice" type="note" label="COM_MINIMARKET_FILTER_PLANNED"
               description="COM_MINIMARKET_FILTER_PLANNED_DESC" showon="is_filterable:1"/>
    </fieldset>
    <fieldset name="publishing" label="COM_MINIMARKET_CATEGORY_TAB_PUBLISHING">
        <field name="sort_order" type="number" label="JGRID_HEADING_ORDERING" default="0" min="0" max="4294967295" step="1" filter="uint"/>
        <field name="state" type="list" label="JSTATUS" default="0" filter="int">
            <option value="0">JUNPUBLISHED</option><option value="1">JPUBLISHED</option>
        </field>
    </fieldset>
</form>
