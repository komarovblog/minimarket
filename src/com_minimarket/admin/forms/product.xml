<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="MiniMarket\Component\Minimarket\Administrator\Field">
    <fieldset name="details" label="COM_MINIMARKET_PRODUCT_TAB_DETAILS">
        <field name="id" type="hidden" default="0" filter="int"/>
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" filter="string" size="60"/>
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" filter="string" size="60"/>
        <field name="category_id" type="Productcategory" label="COM_MINIMARKET_PRODUCT_CATEGORY"
               description="COM_MINIMARKET_PRODUCT_CATEGORY_DESC" default="" required="true" filter="int">
            <option value="">COM_MINIMARKET_SELECT_CATEGORY</option>
        </field>
        <field name="product_type" type="list" label="COM_MINIMARKET_PRODUCT_TYPE"
               description="COM_MINIMARKET_PRODUCT_TYPE_HELP" filter="string" default="simple">
            <option value="simple">COM_MINIMARKET_PRODUCT_TYPE_SIMPLE</option>
            <option value="bundle">COM_MINIMARKET_PRODUCT_TYPE_BUNDLE</option>
        </field>
        <field name="sku" type="text" label="COM_MINIMARKET_PRODUCT_SKU" required="true" filter="string" size="40" maxlength="100"/>
        <field name="price" type="number" label="COM_MINIMARKET_PRODUCT_PRICE" default="0.00"
               min="0" max="9999999999999.99" step="0.01" required="true" filter="string"/>
        <field name="stock" type="number" label="COM_MINIMARKET_PRODUCT_STOCK" default="0"
               description="COM_MINIMARKET_OPTION_STOCK_MAIN_HELP"
               min="0" max="4294967295" step="1" required="true" filter="string"/>
        <field name="option_stock_mode" type="radio" label="COM_MINIMARKET_OPTION_STOCK_MODE"
               description="COM_MINIMARKET_OPTION_STOCK_HELP"
               default="1" filter="int">
            <option value="0">COM_MINIMARKET_OPTION_STOCK_SHARED</option>
            <option value="1">COM_MINIMARKET_OPTION_STOCK_PER_COMBINATION</option>
        </field>
        <field name="sort_order" type="number" label="COM_MINIMARKET_CATEGORY_ORDER"
               filter="uint" default="0" min="0" max="4294967295"/>
    </fieldset>
    <fieldset name="merchandising" label="COM_MINIMARKET_PRODUCT_TAB_MERCHANDISING">
        <field name="brand_id" type="Brandlist" label="COM_MINIMARKET_PRODUCT_BRAND"
               description="COM_MINIMARKET_PRODUCT_BRAND_HELP" default="0" filter="int">
            <option value="0">COM_MINIMARKET_PRODUCT_BRAND_NONE</option>
        </field>
        <field name="collections_present" type="hidden" filter="int" default="1"/>
        <field name="collection_ids" type="Collectionlist" label="COM_MINIMARKET_PRODUCT_COLLECTIONS"
               description="COM_MINIMARKET_PRODUCT_COLLECTIONS_HELP"
               multiple="true" filter="array"/>
    </fieldset>
    <fieldset name="descriptions" label="COM_MINIMARKET_PRODUCT_TAB_DESCRIPTIONS">
        <field name="introtext" type="editor" label="COM_MINIMARKET_CATEGORY_INTRO" filter="safehtml" buttons="true"/>
        <field name="description" type="editor" label="JGLOBAL_DESCRIPTION" filter="safehtml" buttons="true"/>
    </fieldset>
    <fieldset name="attributes" label="COM_MINIMARKET_PRODUCT_TAB_ATTRIBUTES">
        <field name="attributes_present" type="hidden" filter="int" default="1"/>
        <field name="attribute_values" type="Productattributes" filter="raw"
               label="COM_MINIMARKET_PRODUCT_TAB_ATTRIBUTES"/>
    </fieldset>
    <fieldset name="images" label="COM_MINIMARKET_PRODUCT_TAB_IMAGES">
        <field name="gallery_present" type="hidden" default="1" filter="int"/>
        <field name="image" type="media" label="COM_MINIMARKET_PRODUCT_IMAGE" filter="string" directory="images"/>
        <field name="image_alt" type="text" label="COM_MINIMARKET_CATEGORY_IMAGE_ALT" filter="string" maxlength="255"/>
        <field name="gallery" type="subform" label="COM_MINIMARKET_GALLERY_ADDITIONAL"
               description="COM_MINIMARKET_GALLERY_HELP"
               formsource="administrator/components/com_minimarket/forms/product_gallery.xml"
               multiple="true" min="0" max="30" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform" />
    </fieldset>
    <fieldset name="videos" label="COM_MINIMARKET_PRODUCT_TAB_VIDEOS">
        <field name="videos_present" type="hidden" default="1" filter="int"/>
        <field name="videos" type="subform" label="COM_MINIMARKET_PRODUCT_TAB_VIDEOS"
               description="COM_MINIMARKET_VIDEO_HELP"
               formsource="administrator/components/com_minimarket/forms/product_video.xml"
               multiple="true" min="0" max="20" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"/>
    </fieldset>
    <fieldset name="variants" label="COM_MINIMARKET_PRODUCT_TAB_VARIANTS">
        <field name="variants_workflow" type="note" label="COM_MINIMARKET_VARIANTS_WORKFLOW" description="COM_MINIMARKET_VARIANTS_WORKFLOW_DESC"/>
        <field name="category_option_preview" type="Productcategoryoptions" filter="raw"
               label="COM_MINIMARKET_PRODUCT_OPTIONS_FROM_CATEGORY"/>
        <field name="variants_present" type="hidden" default="1" filter="int"/>
        <field name="variant_dimensions_present" type="hidden" filter="int" default="1"/>
        <field name="variant_dimensions" type="subform" label="COM_MINIMARKET_LOCAL_VARIANTS_TITLE"
               formsource="administrator/components/com_minimarket/forms/product_variant_dimension.xml"
               multiple="true" min="0" max="4" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"/>
        <field name="variant_matrix" type="Variantbuilder" label="COM_MINIMARKET_LOCAL_PREVIEW" filter="raw"/>
        <field name="sku_matrix_payload" type="Skumatrix" filter="raw"
               label="COM_MINIMARKET_MATRIX_TITLE"/>
        <field name="variants" type="subform" label="COM_MINIMARKET_PRODUCT_TAB_VARIANTS"
               description="COM_MINIMARKET_VARIANTS_HELP"
               formsource="administrator/components/com_minimarket/forms/product_variant.xml"
               multiple="true" min="0" max="200" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"/>
    </fieldset>
    <fieldset name="bundle" label="COM_MINIMARKET_PRODUCT_TAB_BUNDLE">
        <field name="bundle_help" type="note" label="COM_MINIMARKET_PRODUCT_TAB_BUNDLE"
               description="COM_MINIMARKET_BUNDLE_HELP"/>
        <field name="bundle_items_present" type="hidden" default="1" filter="int"/>
        <field name="bundle_items" type="subform"
               label="COM_MINIMARKET_BUNDLE_COMPONENTS"
               description="COM_MINIMARKET_BUNDLE_COMPONENTS_HELP"
               formsource="administrator/components/com_minimarket/forms/product_bundle_item.xml"
               multiple="true" min="0" max="40" buttons="add,remove,move"
               layout="joomla.form.field.subform.repeatable" validate="Subform"/>
    </fieldset>
    <fieldset name="groups" label="COM_MINIMARKET_PRODUCT_TAB_GROUPS">
        <field name="group_editor" type="Groupeditor" mode="product" filter="raw"
               label="COM_MINIMARKET_PRODUCT_TAB_GROUPS"/>
    </fieldset>
    <fieldset name="seo" label="COM_MINIMARKET_CATEGORY_TAB_SEO">
        <field name="meta_title" type="text" label="COM_MINIMARKET_META_TITLE" filter="string" maxlength="255" size="60"/>
        <field name="meta_description" type="textarea" label="COM_MINIMARKET_META_DESCRIPTION"
               description="COM_MINIMARKET_META_DESCRIPTION_DESC" filter="string" maxlength="320" rows="3"/>
        <field name="meta_robots" type="list" label="COM_MINIMARKET_META_ROBOTS" filter="string" default="">
            <option value="">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="index,follow">COM_MINIMARKET_ROBOTS_INDEX_FOLLOW</option>
            <option value="noindex,follow">COM_MINIMARKET_ROBOTS_NOINDEX_FOLLOW</option>
            <option value="noindex,nofollow">COM_MINIMARKET_ROBOTS_NOINDEX_NOFOLLOW</option>
        </field>
        <field name="og_title" type="text" label="COM_MINIMARKET_OG_TITLE" filter="string" maxlength="255" size="60"/>
        <field name="og_description" type="textarea" label="COM_MINIMARKET_OG_DESCRIPTION"
               filter="string" maxlength="320" rows="3"/>
        <field name="og_image" type="media" label="COM_MINIMARKET_OG_IMAGE" filter="string" directory="images"/>
        <field name="og_image_alt" type="text" label="COM_MINIMARKET_OG_IMAGE_ALT" filter="string" maxlength="255"/>
    </fieldset>
    <fieldset name="publishing" label="COM_MINIMARKET_CATEGORY_TAB_PUBLISHING">
        <field name="state" type="list" label="JSTATUS" default="0" filter="int">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>
    </fieldset>
</form>
