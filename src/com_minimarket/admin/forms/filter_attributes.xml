<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" inputmode="search"
               label="COM_MINIMARKET_CATEGORY_FILTER_SEARCH" hint="JSEARCH_FILTER" />
        <field name="published" type="list" label="JSTATUS" class="js-select-submit-on-change">
            <option value="">COM_MINIMARKET_CATEGORY_ALL_STATUSES</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY"
               class="js-select-submit-on-change" default="a.sort_order ASC" validate="options">
            <option value="a.sort_order ASC">JGRID_HEADING_ORDERING</option>
            <option value="a.title ASC">COM_MINIMARKET_ATTRIBUTE_SORT_TITLE_ASC</option>
            <option value="a.title DESC">COM_MINIMARKET_ATTRIBUTE_SORT_TITLE_DESC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT"
               class="js-select-submit-on-change" default="20"/>
    </fields>
</form>
