<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="details" label="COM_MINIMARKET_BRAND_EDIT">
        <field name="id" type="hidden" default="0" filter="int"/>
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true"
               maxlength="255" filter="string" size="60"/>
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL"
               maxlength="255" filter="string" size="60"/>
        <field name="website_url" type="url" label="COM_MINIMARKET_BRAND_WEBSITE"
               filter="string" maxlength="1024" relative="false" validate="url"/>
        <field name="image" type="media" label="COM_MINIMARKET_BRAND_IMAGE"
               filter="string" directory="images"/>
        <field name="image_alt" type="text" label="COM_MINIMARKET_CATEGORY_IMAGE_ALT"
               filter="string" maxlength="255"/>
    </fieldset>
    <fieldset name="descriptions" label="COM_MINIMARKET_PRODUCT_TAB_DESCRIPTIONS">
        <field name="introtext" type="editor" label="COM_MINIMARKET_CATEGORY_INTRO"
               filter="safehtml" buttons="true"/>
        <field name="description" type="editor" label="JGLOBAL_DESCRIPTION"
               filter="safehtml" buttons="true"/>
    </fieldset>
    <fieldset name="seo" label="COM_MINIMARKET_CATEGORY_TAB_SEO">
        <field name="meta_title" type="text" label="COM_MINIMARKET_META_TITLE"
               maxlength="255" filter="string" size="60"/>
        <field name="meta_description" type="textarea" label="COM_MINIMARKET_META_DESCRIPTION"
               maxlength="320" filter="string" rows="3"/>
        <field name="meta_robots" type="list" label="COM_MINIMARKET_META_ROBOTS" filter="string" default="">
            <option value="">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="index,follow">COM_MINIMARKET_ROBOTS_INDEX_FOLLOW</option>
            <option value="noindex,follow">COM_MINIMARKET_ROBOTS_NOINDEX_FOLLOW</option>
            <option value="noindex,nofollow">COM_MINIMARKET_ROBOTS_NOINDEX_NOFOLLOW</option>
        </field>
        <field name="og_title" type="text" label="COM_MINIMARKET_OG_TITLE"
               maxlength="255" filter="string"/>
        <field name="og_description" type="textarea" label="COM_MINIMARKET_OG_DESCRIPTION"
               maxlength="320" filter="string" rows="3"/>
        <field name="og_image" type="media" label="COM_MINIMARKET_OG_IMAGE"
               filter="string" directory="images"/>
        <field name="og_image_alt" type="text" label="COM_MINIMARKET_OG_IMAGE_ALT"
               maxlength="255" filter="string"/>
    </fieldset>
    <fieldset name="publishing" label="COM_MINIMARKET_CATEGORY_TAB_PUBLISHING">
        <field name="state" type="list" label="JSTATUS" default="0" filter="int">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>
        <field name="sort_order" type="number" label="JGRID_HEADING_ORDERING"
               default="0" min="0" max="4294967295" filter="uint"/>
    </fieldset>
</form>
