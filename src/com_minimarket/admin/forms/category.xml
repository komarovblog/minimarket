<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="MiniMarket\Component\Minimarket\Administrator\Field">
    <fieldset name="details" label="COM_MINIMARKET_CATEGORY_TAB_DETAILS">
        <field name="id" type="hidden" default="0" filter="int"/>
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" filter="string" size="60"/>
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" filter="string" size="60"/>
        <field name="parent_id" type="Categoryparent" label="COM_MINIMARKET_CATEGORY_PARENT"
               description="COM_MINIMARKET_CATEGORY_PARENT_DESC" default="0" filter="int">
            <option value="0">COM_MINIMARKET_CATEGORY_PARENT_ROOT</option>
        </field>
        <field name="image" type="media" label="COM_MINIMARKET_CATEGORY_IMAGE" filter="string" directory="images"/>
        <field name="image_alt" type="text" label="COM_MINIMARKET_CATEGORY_IMAGE_ALT" filter="string" size="60"/>
    </fieldset>
    <fieldset name="descriptions" label="COM_MINIMARKET_CATEGORY_TAB_DESCRIPTIONS">
        <field name="introtext" type="editor" label="COM_MINIMARKET_CATEGORY_INTRO" filter="safehtml" buttons="true"/>
        <field name="description" type="editor" label="JGLOBAL_DESCRIPTION" filter="safehtml" buttons="true"/>
    </fieldset>
    <fieldset name="display" label="COM_MINIMARKET_CATEGORY_TAB_DISPLAY">
        <field name="show_children" type="list" label="COM_MINIMARKET_CATEGORY_SHOW_CHILDREN" filter="int" default="-1">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="show_bundles" type="list" label="COM_MINIMARKET_CATEGORY_SHOW_BUNDLES" filter="int" default="-1">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="show_products" type="list" label="COM_MINIMARKET_CATEGORY_SHOW_PRODUCTS" filter="int" default="-1">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="show_descendant_products" type="list" label="COM_MINIMARKET_CATEGORY_DESCENDANT_PRODUCTS" filter="int" default="-1">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="show_descendant_bundles" type="list" label="COM_MINIMARKET_CATEGORY_DESCENDANT_BUNDLES" filter="int" default="-1">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="product_layout" type="list" label="COM_MINIMARKET_CATEGORY_PRODUCT_LAYOUT" default="inherit" filter="cmd">
            <option value="inherit">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="list">COM_MINIMARKET_LAYOUT_LIST</option>
            <option value="grid">COM_MINIMARKET_LAYOUT_GRID</option>
        </field>
        <field name="cards_xs" type="Gridcards" label="COM_MINIMARKET_CARDS_XS"
               description="COM_MINIMARKET_CARDS_XS_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="cards_sm" type="Gridcards" label="COM_MINIMARKET_CARDS_SM"
               description="COM_MINIMARKET_CARDS_SM_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="cards_md" type="Gridcards" label="COM_MINIMARKET_CARDS_MD"
               description="COM_MINIMARKET_CARDS_MD_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="cards_lg" type="Gridcards" label="COM_MINIMARKET_CARDS_LG"
               description="COM_MINIMARKET_CARDS_LG_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="cards_xl" type="Gridcards" label="COM_MINIMARKET_CARDS_XL"
               description="COM_MINIMARKET_CARDS_XL_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="cards_xxl" type="Gridcards" label="COM_MINIMARKET_CARDS_XXL"
               description="COM_MINIMARKET_CARDS_XXL_DESC" default="-1" filter="int">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </field>
        <field name="products_per_page" type="list" default="0" filter="int"
               label="COM_MINIMARKET_PRODUCTS_PER_PAGE">
            <option value="0">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="30">30</option>
            <option value="50">50</option>
        </field>
    </fieldset>
    <fieldset name="system_filters" label="COM_MINIMARKET_SYSTEM_FILTERS">
        <field name="filter_price_mode" type="list" default="inherit" filter="cmd"
               label="COM_MINIMARKET_SYSTEM_PRICE_FILTER">
            <option value="inherit">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="none">COM_MINIMARKET_MODE_NONE</option>
            <option value="range">COM_MINIMARKET_FILTER_RANGE</option>
            <option value="slider">COM_MINIMARKET_FILTER_SLIDER</option>
        </field>
        <field name="filter_sku_mode" type="list" default="inherit" filter="cmd"
               label="COM_MINIMARKET_SYSTEM_SKU_FILTER">
            <option value="inherit">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="none">COM_MINIMARKET_MODE_NONE</option>
            <option value="text">COM_MINIMARKET_SYSTEM_SKU_SEARCH</option>
        </field>
        <field name="filter_stock_mode" type="list" default="-1" filter="int"
               label="COM_MINIMARKET_SYSTEM_STOCK_FILTER">
            <option value="-1">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
    </fieldset>
    <fieldset name="attributes" label="COM_MINIMARKET_CATEGORY_TAB_ATTRIBUTES">
        <field name="attribute_rules" type="Categoryattributes" filter="raw"
               label="COM_MINIMARKET_CATATTR_LABEL"/>
        <field name="attributes_present" type="hidden" filter="int" default="1"/>
    </fieldset>
    <fieldset name="order_options" label="COM_MINIMARKET_ORDER_OPTIONS">
        <field name="order_options_present" type="hidden" default="1" filter="int"/>
        <field name="order_option_rules" type="Categoryorderoptions" filter="raw"
               label="COM_MINIMARKET_ORDER_OPTIONS"/>
    </fieldset>
    <fieldset name="seo" label="COM_MINIMARKET_CATEGORY_TAB_SEO">
        <field name="meta_title" type="text" label="COM_MINIMARKET_META_TITLE" filter="string" maxlength="255" size="60"/>
        <field name="meta_description" type="textarea" label="COM_MINIMARKET_META_DESCRIPTION"
               description="COM_MINIMARKET_META_DESCRIPTION_DESC" filter="string" maxlength="320" rows="3"/>
        <field name="meta_robots" type="list" label="COM_MINIMARKET_META_ROBOTS" filter="string" default="">
            <option value="">COM_MINIMARKET_CATEGORY_INHERIT</option>
            <option value="index,follow">COM_MINIMARKET_ROBOTS_INDEX_FOLLOW</option>
            <option value="noindex,follow">COM_MINIMARKET_ROBOTS_NOINDEX_FOLLOW</option>
            <option value="noindex,nofollow">COM_MINIMARKET_ROBOTS_NOINDEX_NOFOLLOW</option>
        </field>
        <field name="og_title" type="text" label="COM_MINIMARKET_OG_TITLE" filter="string" maxlength="255" size="60"/>
        <field name="og_description" type="textarea" label="COM_MINIMARKET_OG_DESCRIPTION"
               filter="string" maxlength="320" rows="3"/>
        <field name="og_image" type="media" label="COM_MINIMARKET_OG_IMAGE" filter="string" directory="images"/>
        <field name="og_image_alt" type="text" label="COM_MINIMARKET_OG_IMAGE_ALT" filter="string" maxlength="255"/>
    </fieldset>
    <fieldset name="publishing" label="COM_MINIMARKET_CATEGORY_TAB_PUBLISHING">
        <field name="sort_order" type="number" label="COM_MINIMARKET_CATEGORY_ORDER"
               filter="uint" default="0" min="0" max="4294967295"/>
        <field name="state" type="list" label="JSTATUS" default="0" filter="int">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>
    </fieldset>
</form>
