<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="MiniMarket\Component\Minimarket\Administrator\Field">
  <fieldset name="details" label="COM_MINIMARKET_ORDER_OPTION_EDIT">
    <field name="id" type="hidden" default="0" filter="int"/>
    <field name="title" type="text" label="JGLOBAL_TITLE" required="true"
           maxlength="255" filter="string" size="48"/>
        <field name="display_location" type="list" default="inherit" filter="cmd"
               label="COM_MINIMARKET_ENTITY_DISPLAY_LOCATION"
               description="COM_MINIMARKET_ENTITY_DISPLAY_LOCATION_DESC">
            <option value="inherit">COM_MINIMARKET_VISIBILITY_DEFAULT</option>
            <option value="product">COM_MINIMARKET_VISIBILITY_PRODUCT</option>
            <option value="category">COM_MINIMARKET_VISIBILITY_CATEGORY</option>
            <option value="both">COM_MINIMARKET_VISIBILITY_BOTH</option>
        </field>
    <field name="code" type="text" label="COM_MINIMARKET_ORDER_OPTION_CODE"
           description="COM_MINIMARKET_ORDER_OPTION_CODE_DESC" maxlength="100"
           filter="string" size="32"/>
  </fieldset>
  <fieldset name="values" label="COM_MINIMARKET_ORDER_OPTION_VALUES">
    <field name="values_present" type="hidden" default="1" filter="int"/>
    <field name="option_values" type="subform" label="COM_MINIMARKET_ORDER_OPTION_VALUES"
           description="COM_MINIMARKET_ORDER_OPTION_VALUES_DESC"
           formsource="administrator/components/com_minimarket/forms/orderoptionvalue.xml"
           multiple="true" min="0" max="250" buttons="add,remove,move"
           layout="joomla.form.field.subform.repeatable" validate="Subform"/>
  </fieldset>
  <fieldset name="categories" label="COM_MINIMARKET_ORDER_OPTION_CATEGORIES">
    <field name="categories_present" type="hidden" default="1" filter="int"/>
    <field name="category_rules" type="Optioncategories" filter="raw"
           label="COM_MINIMARKET_ORDER_OPTION_CATEGORIES"/>
  </fieldset>
    <fieldset name="publishing" label="COM_MINIMARKET_CATEGORY_TAB_PUBLISHING">
    <field name="state" type="list" label="JSTATUS" filter="int" default="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
    </field>
    <field name="sort_order" type="number" label="JGRID_HEADING_ORDERING"
           min="0" max="4294967295" default="0" filter="uint"/>
    </fieldset>
</form>
