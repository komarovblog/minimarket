<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="details" label="COM_MINIMARKET_VALUE_DETAILS">
        <field name="id" type="hidden" default="0" filter="int"/>
        <field name="attribute_id" type="sql" label="COM_MINIMARKET_VALUE_ATTRIBUTE"
            query="SELECT id, title FROM #__minimarket_attributes WHERE input_type = 'list' ORDER BY title, id"
            key_field="id" value_field="title" header="COM_MINIMARKET_SELECT_ATTRIBUTE"
            required="true" filter="int"/>
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" filter="string" size="60"/>
        <field name="code" type="text" label="COM_MINIMARKET_VALUE_CODE" description="COM_MINIMARKET_ATTRIBUTE_CODE_DESC" required="true" filter="string" size="40"/>
        <field name="sort_order" type="number" label="JGRID_HEADING_ORDERING" default="0" min="0" max="4294967295" step="1" filter="uint"/>
        <field name="state" type="list" label="JSTATUS" default="0" filter="int">
            <option value="0">JUNPUBLISHED</option><option value="1">JPUBLISHED</option>
        </field>
    </fieldset>
</form>
