<?xml version="1.0" encoding="UTF-8"?>
<config>
    <fieldset name="basic" label="COM_MINIMARKET_CONFIG_BASIC" addfieldprefix="MiniMarket\Component\Minimarket\Administrator\Field">
        <field
            name="catalog_title"
            type="text"
            label="COM_MINIMARKET_CONFIG_CATALOG_TITLE"
            description="COM_MINIMARKET_CONFIG_CATALOG_TITLE_DESC"
            default="MiniMarket"
            filter="string"
        />
        <field
            name="primary_shop_itemid"
            type="Shopmenu"
            label="COM_MINIMARKET_CONFIG_PRIMARY_MENU"
            description="COM_MINIMARKET_CONFIG_PRIMARY_MENU_DESC"
            default="0"
            filter="integer"
        >
            <option value="0">COM_MINIMARKET_CONFIG_PRIMARY_MENU_AUTO</option>
        </field>

<field name="inventory_enabled" type="list" default="1" filter="int"
               label="COM_MINIMARKET_CONFIG_INVENTORY_ENABLED"
               description="COM_MINIMARKET_CONFIG_INVENTORY_HELP">
            <option value="1">COM_MINIMARKET_ENABLE</option><option value="0">COM_MINIMARKET_DISABLE</option>
        </field>
        <field name="mm_system_filters_note" type="note" class="alert alert-info" label="COM_MINIMARKET_SYSTEM_ATTRIBUTES_IN_FILTER" description="COM_MINIMARKET_SYSTEM_INDEPENDENT_HELP" />
        <field name="filter_price_mode" type="list" default="slider" filter="cmd"
                       label="COM_MINIMARKET_SYSTEM_PRICE_FILTER" description="COM_MINIMARKET_SYSTEM_PRICE_FILTER_DESC">
                    <option value="none">COM_MINIMARKET_MODE_NONE</option>
                    <option value="range">COM_MINIMARKET_FILTER_RANGE</option>
                    <option value="slider">COM_MINIMARKET_FILTER_SLIDER</option>
                </field>
        <field name="system_price_display_location" type="list" default="both" filter="cmd"
               label="COM_MINIMARKET_SYSTEM_PRICE_DISPLAY_LOCATION">
            <option value="product">COM_MINIMARKET_VISIBILITY_PRODUCT</option>
            <option value="category">COM_MINIMARKET_VISIBILITY_CATEGORY</option>
            <option value="both">COM_MINIMARKET_VISIBILITY_BOTH</option>
        </field>
        <field name="filter_sku_mode" type="list" default="none" filter="cmd"
                       label="COM_MINIMARKET_SYSTEM_SKU_FILTER">
                    <option value="none">COM_MINIMARKET_MODE_NONE</option>
                    <option value="text">COM_MINIMARKET_SYSTEM_SKU_SEARCH</option>
                </field>
        <field name="system_sku_display_location" type="list" default="both" filter="cmd"
               label="COM_MINIMARKET_SYSTEM_SKU_DISPLAY_LOCATION">
            <option value="product">COM_MINIMARKET_VISIBILITY_PRODUCT</option>
            <option value="category">COM_MINIMARKET_VISIBILITY_CATEGORY</option>
            <option value="both">COM_MINIMARKET_VISIBILITY_BOTH</option>
        </field>
        <field name="filter_stock_enabled" type="list" default="0" filter="int"
                       label="COM_MINIMARKET_SYSTEM_STOCK_FILTER">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="system_stock_display_location" type="list" default="both" filter="cmd"
               label="COM_MINIMARKET_SYSTEM_STOCK_DISPLAY_LOCATION">
            <option value="product">COM_MINIMARKET_VISIBILITY_PRODUCT</option>
            <option value="category">COM_MINIMARKET_VISIBILITY_CATEGORY</option>
            <option value="both">COM_MINIMARKET_VISIBILITY_BOTH</option>
        </field>

        <field name="mm_pagination_note" type="note" class="alert alert-info" label="COM_MINIMARKET_PAGINATION_SETTINGS" description="COM_MINIMARKET_PAGINATION_SETTINGS_DESC" />
        <field name="category_navigation_mode" type="list" default="pages" filter="cmd" label="COM_MINIMARKET_NAV_MODE">
            <option value="pages">COM_MINIMARKET_NAV_PAGES</option><option value="load_more">COM_MINIMARKET_NAV_LOAD_MORE</option>
        </field>
        <field name="category_load_trigger" type="list" default="button" filter="cmd" label="COM_MINIMARKET_NAV_LOAD_TRIGGER" showon="category_navigation_mode:load_more">
            <option value="button">COM_MINIMARKET_NAV_BUTTON</option><option value="scroll">COM_MINIMARKET_NAV_SCROLL</option>
        </field>
        <field name="category_products_per_page" type="list" default="10" filter="int"
                       label="COM_MINIMARKET_PRODUCTS_PER_PAGE" description="COM_MINIMARKET_PRODUCTS_PER_PAGE_DESC">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                </field>




<field name="mm_commands_note" type="note" class="alert alert-info" label="COM_MINIMARKET_COMMANDS_GROUP"
               description="COM_MINIMARKET_COMMANDS_GROUP_DESC"/>
        <field name="offcanvas_cart_target" type="text" filter="string" maxlength="64"
               label="COM_MINIMARKET_COMMANDS_CART" description="COM_MINIMARKET_COMMANDS_TARGET_HELP"
               default="" hint="#offcanvas-cart"/>
        <field name="offcanvas_filters_target" type="text" filter="string" maxlength="64"
               label="COM_MINIMARKET_COMMANDS_FILTERS" description="COM_MINIMARKET_COMMANDS_TARGET_HELP"
               default="" hint="#offcanvas-filters"/>
        <field name="offcanvas_account_target" type="text" filter="string" maxlength="64"
               label="COM_MINIMARKET_COMMANDS_ACCOUNT" description="COM_MINIMARKET_COMMANDS_TARGET_HELP"
               default="" hint="#offcanvas-account"/>
        <field name="offcanvas_menu_target" type="text" filter="string" maxlength="64"
               label="COM_MINIMARKET_COMMANDS_MENU" description="COM_MINIMARKET_COMMANDS_TARGET_HELP"
               default="" hint="#offcanvas-menu"/>
    </fieldset>
    <fieldset name="display" label="COM_MINIMARKET_CONFIG_DISPLAY">
        <field name="mm_display_categories_note" type="note" label="COM_MINIMARKET_DISPLAY_CATEGORIES_SECTION" description="COM_MINIMARKET_DISPLAY_CATEGORIES_HELP" class="alert alert-info" />
        <field name="category_show_image" type="list" default="1" filter="int" label="COM_MINIMARKET_DISPLAY_CATEGORY_IMAGE">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_introtext" type="list" default="1" filter="int" label="COM_MINIMARKET_DISPLAY_CATEGORY_INTRO">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_description" type="list" default="1" filter="int" label="COM_MINIMARKET_DISPLAY_CATEGORY_DESCRIPTION">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_children" type="list" label="COM_MINIMARKET_GLOBAL_SHOW_CHILDREN" default="1" filter="int">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_products" type="list" label="COM_MINIMARKET_GLOBAL_SHOW_PRODUCTS" default="1" filter="int">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_bundles" type="list" label="COM_MINIMARKET_GLOBAL_SHOW_BUNDLES" default="1" filter="int">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_descendant_products" type="list" label="COM_MINIMARKET_GLOBAL_DESCENDANT_PRODUCTS" default="0" filter="int">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_descendant_bundles" type="list" label="COM_MINIMARKET_GLOBAL_DESCENDANT_BUNDLES" default="0" filter="int">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_show_sort" type="list" label="COM_MINIMARKET_CATEGORY_SHOW_SORT" default="1" filter="int">
  <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
</field>
        <field name="category_lazy_loading" type="hidden" default="1" filter="int" />
<field name="mm_display_products_note" type="note" label="COM_MINIMARKET_DISPLAY_PRODUCTS_SECTION" description="COM_MINIMARKET_DISPLAY_PRODUCTS_HELP" class="alert alert-info" />
        <field name="category_product_layout" type="list" label="COM_MINIMARKET_CATEGORY_PRODUCT_LAYOUT" default="grid" filter="cmd">
                    <option value="list">COM_MINIMARKET_LAYOUT_LIST</option>
                    <option value="grid">COM_MINIMARKET_LAYOUT_GRID</option>
                </field>
        <field name="category_cards_xs" type="Gridcards" label="COM_MINIMARKET_CARDS_XS"
                       description="COM_MINIMARKET_CARDS_XS_DESC" default="1" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_cards_sm" type="Gridcards" label="COM_MINIMARKET_CARDS_SM"
                       description="COM_MINIMARKET_CARDS_SM_DESC" default="1" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_cards_md" type="Gridcards" label="COM_MINIMARKET_CARDS_MD"
                       description="COM_MINIMARKET_CARDS_MD_DESC" default="2" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_cards_lg" type="Gridcards" label="COM_MINIMARKET_CARDS_LG"
                       description="COM_MINIMARKET_CARDS_LG_DESC" default="3" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_cards_xl" type="Gridcards" label="COM_MINIMARKET_CARDS_XL"
                       description="COM_MINIMARKET_CARDS_XL_DESC" default="4" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_cards_xxl" type="Gridcards" label="COM_MINIMARKET_CARDS_XXL"
                       description="COM_MINIMARKET_CARDS_XXL_DESC" default="4" showon="category_product_layout:grid" filter="int">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
        <field name="category_allow_layout_switch" type="list" label="COM_MINIMARKET_CATEGORY_ALLOW_LAYOUT_SWITCH" default="1" filter="int">
  <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
</field>
<field name="mm_display_card_note" type="note" label="COM_MINIMARKET_DISPLAY_PRODUCT_CARD_SECTION" description="COM_MINIMARKET_DISPLAY_CARD_HELP" class="alert alert-info" />
        <field name="category_list_show_attributes" type="list" label="COM_MINIMARKET_CATEGORY_LIST_ATTRIBUTES" description="COM_MINIMARKET_CATEGORY_LIST_ATTRIBUTES_DESC" default="1" filter="int">
  <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
</field>
        <field name="category_list_show_options" type="list" label="COM_MINIMARKET_CATEGORY_LIST_OPTIONS" description="COM_MINIMARKET_CATEGORY_LIST_OPTIONS_DESC" default="1" filter="int">
  <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
</field>
        <field name="category_show_add_to_cart" type="list" default="1" filter="int" label="COM_MINIMARKET_LIST_ADD_TO_CART">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_quick_view" type="list" default="0" filter="int" label="COM_MINIMARKET_LIST_QUICK_VIEW">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_product_gallery_enabled" type="list" default="1" filter="int" label="COM_MINIMARKET_DISPLAY_PRODUCT_GALLERY">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>
        <field name="category_product_gallery_limit" type="list" default="5" filter="int" label="COM_MINIMARKET_DISPLAY_PRODUCT_GALLERY_LIMIT" showon="category_product_gallery_enabled:1">
                    <option value="3">3</option><option value="5">5</option><option value="8">8</option>
                </field>
        <field name="category_show_badges" type="list" default="1" filter="int" label="COM_MINIMARKET_LIST_SHOW_BADGES">
                    <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
                </field>

        <field name="mm_product_detail_note" type="note" class="alert alert-info"
               label="COM_MINIMARKET_PRODUCT_DETAIL_SECTION" description="COM_MINIMARKET_PRODUCT_DETAIL_SECTION_DESC" />
        <field name="product_detail_layout" type="list" default="full" filter="cmd"
               label="COM_MINIMARKET_PRODUCT_DETAIL_LAYOUT" description="COM_MINIMARKET_PRODUCT_DETAIL_LAYOUT_DESC">
            <option value="full">COM_MINIMARKET_PRODUCT_DETAIL_FULL</option>
            <option value="tabs">COM_MINIMARKET_PRODUCT_DETAIL_TABS</option>
        </field>
        <field name="product_detail_gallery_effect" type="list" default="lightbox" filter="cmd"
               label="COM_MINIMARKET_GALLERY_EFFECT" description="COM_MINIMARKET_GALLERY_EFFECT_DESC">
            <option value="lightbox">COM_MINIMARKET_GALLERY_EFFECT_LIGHTBOX</option>
            <option value="zoom">COM_MINIMARKET_GALLERY_EFFECT_ZOOM</option>
        </field>
        <field name="product_detail_show_similar" type="list" default="0" filter="int"
               label="COM_MINIMARKET_PRODUCT_DETAIL_SIMILAR">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="product_detail_show_bought_together" type="list" default="0" filter="int"
               label="COM_MINIMARKET_PRODUCT_DETAIL_BOUGHT_TOGETHER">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>

<field name="product_detail_sticky_bar" type="list" default="0" filter="int"
               label="COM_MINIMARKET_PRODUCT_DETAIL_STICKY_BAR">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="product_detail_section_nav" type="list" default="0" filter="int"
               label="COM_MINIMARKET_PRODUCT_DETAIL_SECTION_NAV">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
    </fieldset>
    <!-- Checkout is deliberately separated from authentication integrations. -->
    <fieldset name="checkout" label="COM_MINIMARKET_CONFIG_CHECKOUT">
        <field name="checkout_buyer_note" type="note" class="alert alert-info" label="COM_MINIMARKET_CHECKOUT_BUYER_SECTION" description="COM_MINIMARKET_CHECKOUT_BUYER_NOTE"/>
        <field name="checkout_show_login_button" type="list" label="COM_MINIMARKET_CHECKOUT_SHOW_LOGIN" default="1" filter="int">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="checkout_buyer_description" type="editor" filter="safehtml" buttons="true" label="COM_MINIMARKET_CHECKOUT_STEP_DESCRIPTION" />

<field name="checkout_auth_mode" type="list" default="guest" filter="cmd"
               label="COM_MINIMARKET_CONFIG_CHECKOUT_AUTH"
               description="COM_MINIMARKET_CONFIG_CHECKOUT_AUTH_DESC">
            <option value="guest">COM_MINIMARKET_CHECKOUT_AUTH_GUEST</option>
                <option value="email">COM_MINIMARKET_CHECKOUT_AUTH_EMAIL</option>
        </field>
        <!-- Managed by Registration Methods, not a second global dropdown. -->
        <field name="checkout_verification_method" type="hidden" default="email" filter="cmd" />
        <field name="checkout_name_mode" type="list" default="required" filter="cmd"
               label="COM_MINIMARKET_CONFIG_FIELD_NAME" description="COM_MINIMARKET_CONFIG_FIELD_MODES_DESC">
            <option value="hidden">COM_MINIMARKET_FIELD_HIDDEN</option><option value="optional">COM_MINIMARKET_FIELD_OPTIONAL</option><option value="required">COM_MINIMARKET_FIELD_REQUIRED</option>
        </field>
        <field name="checkout_phone_mode" type="list" default="required" filter="cmd"
               label="COM_MINIMARKET_CONFIG_FIELD_PHONE" description="COM_MINIMARKET_CONFIG_CONTACT_DESC">
            <option value="hidden">COM_MINIMARKET_FIELD_HIDDEN</option><option value="optional">COM_MINIMARKET_FIELD_OPTIONAL</option><option value="required">COM_MINIMARKET_FIELD_REQUIRED</option>
        </field>
        <field name="checkout_phone_mask" type="text" maxlength="32" label="COM_MINIMARKET_CHECKOUT_PHONE_MASK" description="COM_MINIMARKET_CHECKOUT_MASK_HELP" filter="string" />
        <field name="checkout_email_mode" type="list" default="optional" filter="cmd"
               label="COM_MINIMARKET_CONFIG_FIELD_EMAIL" description="COM_MINIMARKET_CONFIG_CONTACT_DESC">
            <option value="hidden">COM_MINIMARKET_FIELD_HIDDEN</option><option value="optional">COM_MINIMARKET_FIELD_OPTIONAL</option><option value="required">COM_MINIMARKET_FIELD_REQUIRED</option>
        </field>
        <field name="checkout_comment_mode" type="list" default="optional" filter="cmd"
               label="COM_MINIMARKET_CONFIG_FIELD_COMMENT" description="COM_MINIMARKET_CONFIG_FIELD_MODES_DESC">
            <option value="hidden">COM_MINIMARKET_FIELD_HIDDEN</option><option value="optional">COM_MINIMARKET_FIELD_OPTIONAL</option><option value="required">COM_MINIMARKET_FIELD_REQUIRED</option>
        </field>
        <field name="checkout_custom_fields" type="subform" multiple="true" min="0" max="20"
               formsource="administrator/components/com_minimarket/forms/checkout_extra_field.xml"
               layout="joomla.form.field.subform.repeatable"
               label="COM_MINIMARKET_CHECKOUT_EXTRA_FIELDS" description="COM_MINIMARKET_CHECKOUT_EXTRA_FIELDS_DESC" />
        <field name="checkout_delivery_note" type="note" class="alert alert-info"
               label="COM_MINIMARKET_CHECKOUT_DELIVERY_SECTION" description="COM_MINIMARKET_CHECKOUT_DELIVERY_SECTION_HELP" />
        <field name="checkout_delivery_description" type="editor" filter="safehtml" buttons="true" label="COM_MINIMARKET_CHECKOUT_STEP_DESCRIPTION" />

<field name="checkout_payment_note" type="note" class="alert alert-info"
               label="COM_MINIMARKET_CHECKOUT_PAYMENT_SECTION" description="COM_MINIMARKET_CHECKOUT_PAYMENT_SECTION_HELP" />
        <field name="checkout_payment_description" type="editor" filter="safehtml" buttons="true" label="COM_MINIMARKET_CHECKOUT_STEP_DESCRIPTION" />
        <field name="checkout_confirmation_note" type="note" class="alert alert-info"
               label="COM_MINIMARKET_CHECKOUT_CONFIRMATION" description="COM_MINIMARKET_CHECKOUT_CONFIRMATION_HELP" />
        <field name="checkout_confirmation_description" type="editor" filter="safehtml" buttons="true"
               label="COM_MINIMARKET_CHECKOUT_STEP_DESCRIPTION" />
        <field name="checkout_require_terms" type="list" default="0" filter="int"
               label="COM_MINIMARKET_CHECKOUT_REQUIRE_TERMS">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="checkout_terms_itemid" type="menuitem" default="0" filter="int"
               label="COM_MINIMARKET_CHECKOUT_TERMS_MENU" showon="checkout_require_terms:1" />

</fieldset>
    <fieldset name="reviews" label="COM_MINIMARKET_CONFIG_REVIEWS">
        <field name="reviews_help" type="note" class="alert alert-info" label="COM_MINIMARKET_CONFIG_REVIEWS" description="COM_MINIMARKET_REVIEWS_SECTION_HELP"/>
        <field name="reviews_enabled" type="list" default="0" filter="int"
               label="COM_MINIMARKET_REVIEWS_ENABLED" description="COM_MINIMARKET_REVIEWS_ENABLED_DESC">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="reviews_author_mode" type="list" default="registered" filter="cmd"
               label="COM_MINIMARKET_REVIEWS_WHO">
            <option value="registered">COM_MINIMARKET_REVIEWS_REGISTERED</option>
            <option value="all">COM_MINIMARKET_REVIEWS_EVERYONE</option>
        </field>
        <field name="reviews_moderation" type="list" default="1" filter="int"
               label="COM_MINIMARKET_REVIEWS_MODERATE" description="COM_MINIMARKET_REVIEWS_MODERATE_DESC">
            <option value="1">COM_MINIMARKET_REVIEWS_MODERATE_ALL</option><option value="0">COM_MINIMARKET_REVIEWS_MODERATE_GUESTS</option><option value="2">COM_MINIMARKET_REVIEWS_MODERATE_NONE</option>
        </field>
        <field name="reviews_media_photo" type="list" default="1" filter="int"
               label="COM_MINIMARKET_REVIEWS_PHOTO" description="COM_MINIMARKET_REVIEWS_MEDIA_DESC">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
        <field name="reviews_media_video" type="list" default="1" filter="int"
               label="COM_MINIMARKET_REVIEWS_VIDEO" description="COM_MINIMARKET_REVIEWS_MEDIA_DESC">
            <option value="1">COM_MINIMARKET_SHOW</option><option value="0">COM_MINIMARKET_HIDE</option>
        </field>
    </fieldset>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
        <field
            name="rules"
            type="rules"
            component="com_minimarket"
            section="component"
            label="JCONFIG_PERMISSIONS_LABEL"
            validate="rules"
            filter="rules"
        />
    </fieldset>
</config>
